# Database (Turso / libSQL). For a local file instead: TURSO_DATABASE_URL=file:.data/kidoo.db
TURSO_DATABASE_URL=libsql://kidoo-USER.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=

# Session cookie signing key. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Photos (Cloudflare R2, S3 API). Create an API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kidoo

# Password recovery e-mail (Resend)
RESEND_API_KEY=
MAIL_FROM=KIDOO <no-reply@seu-dominio.com>

# Optional, only while migrating: lets existing users log in with their old password
# (the hash is copied to Turso on the first successful login).
# LEGACY_SUPABASE_URL=
# LEGACY_SUPABASE_ANON_KEY=

# Production default is on. Set both to false only for local test bypass.
AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_ENABLED=true

# URL the Android kids app loads. HTTPS is required for the photo GPS in the WebView.
# Emulator override: http://10.0.2.2:3000 — LAN override: http://SEU-IP:3000
KIDOO_NATIVE_URL=https://kidookids.vercel.app

# Optional Play Store listing for the kids app. When set, Instalar opens the store.
# NEXT_PUBLIC_KIDS_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.kidoo.kids

# Web Push for parent notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@kidoo.app
PUSH_WEBHOOK_SECRET=

# Daily photo purge. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# Generate with: openssl rand -hex 32
CRON_SECRET=
