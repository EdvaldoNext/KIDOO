NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=service_role_secret

# Production default is on. Set both to false only for local test bypass.
AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_ENABLED=true

# URL that the Android kids app loads (emulator: http://10.0.2.2:3000, phone: http://SEU-IP:3000 or the Vercel URL)
KIDOO_NATIVE_URL=http://10.0.2.2:3000

# Optional Play Store listing for the kids app. When set, Instalar opens the store.
# NEXT_PUBLIC_KIDS_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.kidoo.kids

# Web Push for parent notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@kidoo.app
PUSH_WEBHOOK_SECRET=

# After deploy, set platform_settings.push_webhook_url and push_webhook_secret in Supabase
# (same secret as PUSH_WEBHOOK_SECRET; URL: https://SEU-DOMINIO/api/internal/push/task-awaiting-approval)
